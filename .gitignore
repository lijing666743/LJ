__pycache__/
*.pyc
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# 运行日志、自动生成图片和 Dashboard CSV；保留各目录中的 .gitkeep。
logs/**
!logs/.gitkeep
!logs/**/
!logs/README.md
!logs/**/config_snapshot.yaml
!logs/**/aggregate_metrics.json
!logs/**/evaluation_manifest.json
!logs/**/episode_metrics.jsonl
!logs/**/evaluation_metrics.csv
!logs/**/summary.json
!logs/**/service_diagnostic_manifest.json
!logs/**/continuation_from_*.json
plots/*
!plots/.gitkeep
!plots/A/
!plots/A/**
!plots/B/
!plots/B/**
!plots/C/
!plots/C/**
!plots/checkpoint_progress/
!plots/checkpoint_progress/**
!plots/documentation/
!plots/documentation/**
dashboard_logs/**
!dashboard_logs/.gitkeep
!dashboard_logs/**/
!dashboard_logs/**/progress_metrics.csv
!dashboard_logs/**/summary_metrics.csv
!dashboard_logs/**/per_scene_metrics.csv

